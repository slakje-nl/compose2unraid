Title="Compose"
Tag="cubes"
Cond="is_file('/var/run/dockerd.pid')"
Markdown="false"
---
<?php require_once '/usr/local/emhttp/plugins/compose2unraid/include/common.php'; ?>
<style>
.c2u-stack { table-layout: fixed; width: 100%; margin-bottom: 16px; }
.c2u-col-name { width: 26%; }
.c2u-col-stack { width: 12%; }
.c2u-col-health { width: 11%; }
.c2u-col-version { width: 14%; }
.c2u-col-cpu { width: 11%; }
.c2u-col-memory { width: 15%; }
.c2u-col-uptime { width: 11%; }
table.tablesorter.c2u-stack tbody tr td {
  overflow-wrap: anywhere; line-height: normal; padding-top: 6px; padding-bottom: 6px;
}
.c2u-stack th.c2u-stack-name { text-transform: none; letter-spacing: normal; font-size: 1.2rem; }
.c2u-stack th.c2u-stack-name .c2u-note { margin-left: 10px; font-weight: normal; }
.c2u-meter { white-space: nowrap; text-align: left; }
.c2u-usage { display: inline-block; }
.c2u-bar {
  display: block; width: 100%; height: 3px; margin-top: 4px;
  background: rgba(128, 128, 128, 0.25);
}
.c2u-bar > span { display: block; height: 100%; background: currentColor; opacity: 0.6; }
.c2u-stack th.c2u-stack-name a { font-weight: normal; }
.c2u-actions { margin-top: 8px; }
</style>

<div id="c2u-content"><p class="grey-text">Reading the stacks...</p></div>
<div class="c2u-actions">
  <input type="button" value="Refresh stacks" onclick="c2uRefreshStacks(this)">
  <input type="button" value="Check for updates" onclick="c2uCheckUpdates()">
</div>

<script>
function c2uShowCommands(stack) {
  openBox('/plugins/compose2unraid/include/commands.php?stack=' + encodeURIComponent(stack),
    'Commands for ' + stack, 600, 900, true, 'c2uCommandsDone');
}

function c2uTitle(action, stack, services) {
  var verbs = {apply: 'Syncing', update: 'Updating', start: 'Starting', stop: 'Stopping',
    restart: 'Restarting', diff: 'Changes for', recreate: 'Recreating'};
  if (services === '') { return verbs[action] + ' ' + stack; }
  return verbs[action] + ' ' + services.split(' ').join(', ') + ' in ' + stack;
}

function c2uRefreshStacks(button) {
  button.disabled = true;
  button.value = 'Checking...';
  c2uRefresh(true, function () {
    button.disabled = false;
    button.value = 'Refresh stacks';
  });
}

function c2uCheckUpdates() {
  openBox('/plugins/compose2unraid/include/check.php?csrf_token=' + csrf_token,
    'Checking for updates', 600, 900, true, 'c2uCommandsDone');
}

function c2uLogs(name) {
  openBox('/plugins/compose2unraid/include/logs.php?name=' + encodeURIComponent(name)
    + '&csrf_token=' + csrf_token, 'Log of ' + name, 600, 900, true, 'c2uCommandsDone');
}

function c2uRun(action, stack, services) {
  var url = '/plugins/compose2unraid/include/run.php?action=' + encodeURIComponent(action)
    + '&stack=' + encodeURIComponent(stack) + '&services=' + encodeURIComponent(services)
    + '&csrf_token=' + csrf_token;
  openBox(url, c2uTitle(action, stack, services), 600, 900, true, 'c2uRunDone');
}

function c2uMenu(icon) {
  var data = icon.dataset;
  var opts = [];
  function run(action, services) {
    return function (event) { event.preventDefault(); c2uRun(action, data.stack, services); };
  }
  function othersFlagged() {
    return data.flagged.split(' ').some(function (s) { return s !== '' && s !== data.service; });
  }
  if (data.files === '1' && data.state !== '' && data.running !== '0') {
    opts.push({header: 'Container'});
    if (data.state === 'running') {
      opts.push({text: 'Stop', icon: 'fa-stop', action: run('stop', data.service)});
    } else {
      opts.push({text: 'Start', icon: 'fa-play', action: run('start', data.service)});
    }
    opts.push({text: 'Restart', icon: 'fa-refresh', action: run('restart', data.service)});
    opts.push({text: 'Logs (new tab)', icon: 'fa-navicon', action: function (event) {
      event.preventDefault();
      openTerminal('docker', data.name, '.log');
    }});
    opts.push({text: 'Logs (popup)', icon: 'fa-list-alt', action: function (event) {
      event.preventDefault();
      c2uLogs(data.name);
    }});
    if (data.update === '1') {
      opts.push({text: data.state === 'running' ? 'Update and restart' : 'Update and start',
        icon: 'fa-cloud-download', action: run('update', data.service)});
    }
  }
  if (data.files === '1') {
    opts.push({header: 'Stack'});
    if (data.running !== '0') {
      opts.push({text: 'Stop stack', icon: 'fa-stop', action: run('stop', '')});
      opts.push({text: 'Restart stack', icon: 'fa-refresh', action: run('restart', '')});
    } else if (data.containers !== '0') {
      opts.push({text: 'Start stack', icon: 'fa-play', action: run('start', '')});
      opts.push({text: 'Restart stack', icon: 'fa-refresh', action: run('restart', '')});
    }
    if (data.containers !== '0') {
      opts.push({text: 'Recreate stack', icon: 'fa-recycle', action: run('recreate', '')});
    }
    if (data.drift === 'changed' || data.drift === 'new') {
      opts.push({text: 'Show diff', icon: 'fa-list', action: run('diff', '')});
      opts.push({text: 'Sync stack', icon: 'fa-hdd-o', action: run('apply', '')});
    }
    if (othersFlagged()) {
      opts.push({text: 'Update images', icon: 'fa-cloud-download',
        action: run('update', data.flagged)});
    }
  } else {
    opts.push({header: 'Not in stacks'});
  }
  opts.push({text: 'Stack commands', icon: 'fa-terminal', action: function (event) {
    event.preventDefault();
    c2uShowCommands(data.stack);
  }});
  context.settings({right: false, above: 'auto'});
  context.attach('#' + icon.id, opts);
}

function c2uRunDone() {
  c2uRefresh(true);
}

function c2uCommandsDone() {
  c2uRefresh(false);
}

document.addEventListener('click', function (event) {
  var link = event.target.closest('a.c2u-commands');
  if (!link) { return; }
  event.preventDefault();
  c2uShowCommands(link.dataset.stack);
});

var c2uRefresh;
(function () {
  var content = document.getElementById('c2u-content');
  var timer = null;
  var latest = 0;
  var driftWanted = true;
  function refresh(withDrift, done) {
    driftWanted = driftWanted || withDrift;
    if (document.hidden) {
      schedule();
      if (done) { done(); }
      return;
    }
    var request = ++latest;
    var drift = driftWanted;
    var url = '/plugins/compose2unraid/include/stacks.php' + (drift ? '' : '?drift=0');
    fetch(url, { cache: 'no-store' })
      .then(function (response) {
        if (!response.ok) { throw new Error('stacks.php answered ' + response.status); }
        return response.text();
      })
      .then(function (html) {
        if (request !== latest) { return; }
        var fresh = document.createElement('div');
        fresh.innerHTML = html;
        var next = fresh.firstElementChild;
        content.replaceWith(next);
        content = next;
        if (drift) { driftWanted = false; }
        schedule();
      })
      .catch(function () { if (request === latest) { schedule(); } })
      .finally(function () { if (done) { done(); } });
  }
  function schedule() {
    clearTimeout(timer);
    timer = setTimeout(function () { refresh(false); }, 5000);
  }
  c2uRefresh = function (withDrift, done) { clearTimeout(timer); refresh(withDrift, done); };
  refresh(true);
})();
</script>
